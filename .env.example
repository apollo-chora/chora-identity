# Local configuration for chora-identity.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_GRPC_PORT=9090

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
# CHORA_OUTBOX_DSN defaults to the same database when omitted.
POSTGRES_DB=chora_identity
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@postgres:5432/chora_identity?sslmode=disable
CHORA_OUTBOX_DSN=postgres://chora:chora@postgres:5432/chora_identity?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-identity-local

# Event bus — NATS JetStream. Unset disables the bus (in-memory fallback).
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CHORA_SOURCE_PROJECT=chora-local
CHORA_SOURCE_SERVICE=chora-identity

# DEK envelope encryption master KEK: base64 of a 32-byte AES-256 key.
# REQUIRED at boot — the service refuses to start without it.
# The value below is a DEV-ONLY key. Generate a real one for any deployment:
#   head -c 32 /dev/urandom | base64
CHORA_LOCAL_KEK=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Optional: local admin seed (consumed by ./cmd/seed, not by the server).
CHORA_SEED_TENANT_ID=22222222-2222-7222-8222-222222222222
CHORA_SEED_TENANT_SLUG=chora-local
CHORA_SEED_ADMIN_USERNAME=admin
CHORA_SEED_ADMIN_EMAIL=admin@example.com
CHORA_SEED_ADMIN_PASSWORD=change-me

# Optional: additional seed users (consumed by ./cmd/seed, not by the server).
# Setting a _USERNAME makes its _EMAIL and _PASSWORD required. The student
# account is stored with membership_role `learner` — the stored role vocabulary
# has no `student` value.
# CHORA_SEED_INSTRUCTOR_USERNAME=instructor
# CHORA_SEED_INSTRUCTOR_EMAIL=instructor@example.com
# CHORA_SEED_INSTRUCTOR_PASSWORD=change-me
# CHORA_SEED_STUDENT_USERNAME=student
# CHORA_SEED_STUDENT_EMAIL=student@example.com
# CHORA_SEED_STUDENT_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Demo mode (DEFAULT OFF)
#
# Demo mode lets a demo run without a real payment/top-up flow: every seeded
# account starts with a large mana balance, and POST /api/v1/me/mana/demo-grant
# tops one up for free.
#
# The demo grant is enabled ONLY when BOTH flags below are true, and it is
# refused outright when CHORA_ENV is prod/production. CHORA_ENV alone can never
# turn it on. The grant amount is fixed server-side (never read from the request
# body) and the GCID comes only from the validated session context.
#
# CHORA_DEMO_MODE=true
# CHORA_DEMO_MANA_TOPUP_ENABLED=true
# CHORA_DEMO_MANA_GRANT_UNITS=1000000        # fixed per-grant amount
# CHORA_DEMO_MANA_GRANT_MAX_PER_GCID=10       # per-account grant cap (interactive grants)
# CHORA_DEMO_MANA_GRANT_TOTAL_BUDGET=1000000000  # platform-wide budget (interactive grants)
#
# Both caps are enforced INSIDE the transaction that credits the wallet, against
# the reserved/consumed counters in `demo_grant_budget` (migration 0044) — a
# check outside that transaction is a check two concurrent requests can both
# pass. The one-time seed grant (cmd/seed) does not consume either cap.
